<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="HrPlatformApplication（含数据库迁移资源）" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <module name="bootstrap" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.ezaigc.hr.bootstrap.HrPlatformApplication" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
      <!-- Make 可能清理输出目录，必须在它完成后生成并复制全部运行资源。 -->
      <option name="Maven.BeforeRunTask" enabled="true" file="$PROJECT_DIR$/pom.xml" goal="-pl bootstrap -am process-resources" />
    </method>
  </configuration>
</component>
