{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vgo/schema/resume-parse/1.2.json",
  "title": "VGO resume facts 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate", "workExperiences", "projectExperiences", "educations", "skills", "credentials", "languages", "industryTags", "responsibilityTags", "unknownItems"],
  "properties": {
    "candidate": {"type":"object","additionalProperties":false,"required":["fullName"],"properties":{"fullName":{"type":["string","null"],"maxLength":160},"email":{"type":["string","null"],"maxLength":320},"phone":{"type":["string","null"],"maxLength":40},"currentRole":{"type":["string","null"],"maxLength":160},"city":{"type":["string","null"],"maxLength":120},"birthDate":{"type":["string","null"],"pattern":"^[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?$"},"age":{"type":["integer","null"],"minimum":16,"maximum":100},"gender":{"type":["string","null"],"enum":["MALE","FEMALE","OTHER",null]},"jobIntention":{"type":["string","null"],"maxLength":300}}},
    "workExperiences": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/work"}},
    "projectExperiences": {"type":"array","maxItems":200,"items":{"$ref":"#/$defs/project"}},
    "educations": {"type":"array","maxItems":30,"items":{"$ref":"#/$defs/education"}},
    "skills": {"type":"array","maxItems":300,"items":{"$ref":"#/$defs/skill"}},
    "credentials": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/credential"}},
    "languages": {"type":"array","maxItems":50,"items":{"$ref":"#/$defs/language"}},
    "industryTags": {"type":"array","maxItems":100,"items":{"type":"string","maxLength":120}},
    "responsibilityTags": {"type":"array","maxItems":200,"items":{"type":"string","maxLength":200}},
    "unknownItems": {"type":"array","maxItems":200,"items":{"type":"string","maxLength":300}}
  },
  "$defs": {
    "baseItem": {"type":"object","required":["id"]},
    "work": {"type":"object","additionalProperties":false,"required":["id","employer","role","responsibilities","achievements"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},"employer":{"type":["string","null"],"maxLength":200},"role":{"type":["string","null"],"maxLength":160},"startDate":{"type":["string","null"],"pattern":"^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|PRESENT)$"},"endDate":{"type":["string","null"],"pattern":"^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|PRESENT)$"},"description":{"type":["string","null"],"maxLength":5000},"responsibilities":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":500}},"achievements":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":500}}}},
    "project": {"type":"object","additionalProperties":false,"required":["id","projectName","technologies","achievements"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},"projectName":{"type":["string","null"],"maxLength":200},"role":{"type":["string","null"],"maxLength":160},"startDate":{"type":["string","null"],"pattern":"^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|PRESENT)$"},"endDate":{"type":["string","null"],"pattern":"^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|PRESENT)$"},"description":{"type":["string","null"],"maxLength":5000},"technologies":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":120}},"achievements":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":500}}}},
    "education": {"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},"school":{"type":["string","null"],"maxLength":200},"degree":{"type":["string","null"],"maxLength":120},"major":{"type":["string","null"],"maxLength":160},"startDate":{"type":["string","null"],"pattern":"^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|PRESENT)$"},"endDate":{"type":["string","null"],"pattern":"^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|PRESENT)$"},"learningMode":{"type":["string","null"],"maxLength":80}}},
    "skill": {"type":"object","additionalProperties":false,"required":["id","name"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},"name":{"type":"string","minLength":1,"maxLength":120},"level":{"type":["string","null"],"maxLength":80},"years":{"type":["number","null"],"minimum":0,"maximum":80}}},
    "credential": {"type":"object","additionalProperties":false,"required":["id","name"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},"name":{"type":"string","minLength":1,"maxLength":200},"issuer":{"type":["string","null"],"maxLength":200},"issuedDate":{"type":["string","null"],"pattern":"^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|PRESENT)$"},"expiryDate":{"type":["string","null"],"pattern":"^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|PRESENT)$"}}},
    "language": {"type":"object","additionalProperties":false,"required":["id","name"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},"name":{"type":"string","minLength":1,"maxLength":100},"level":{"type":["string","null"],"maxLength":100}}}
  }
}
