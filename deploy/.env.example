# Docker Compose 启动秘密；真实文件位于服务器 /opt/vgo/shared/.env 且权限为 600。
# 国内 ECS 默认通过代理拉取已锁定摘要的 Docker Hub 镜像；开通私有 ACR 后可统一替换前缀。
DOCKER_HUB_MIRROR=docker.m.daocloud.io
# ClamAV 大镜像使用独立国内代理，仍由官方 manifest 摘要校验。
CLAMAV_REGISTRY_MIRROR=docker.1ms.run
MYSQL_ROOT_PASSWORD=REPLACE_WITH_MYSQL_ROOT_PASSWORD
HR_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
ELASTIC_PASSWORD=REPLACE_WITH_ELASTIC_PASSWORD
# RabbitMQ 与后端共用同一组最小权限应用凭据；不得使用 guest 或复用数据库密码。
HR_RABBITMQ_USERNAME=hr_app
HR_RABBITMQ_PASSWORD=REPLACE_WITH_RABBITMQ_PASSWORD
LETSENCRYPT_EMAIL=REPLACE_WITH_CERTIFICATE_EMAIL
